# Copy this file to .env locally. Never commit real credentials.
PORT=5000
MONGODB_URI=mongodb+srv://<db-user>:<db-password>@<cluster-host>/<database>?retryWrites=true&w=majority
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters-long
JWT_EXPIRES_IN=2h
API_BASE_URL=http://localhost:5000
CLIENT_ORIGIN=http://localhost:5000
EMAIL_SERVICE=gmail
EMAIL_USER=your-verification-email@gmail.com
EMAIL_PASS=your-gmail-app-password
# Set only temporarily when running the admin provisioning command:
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=use-a-unique-password-at-least-12-characters
ADMIN_NAME=RoadGuard Administrator
